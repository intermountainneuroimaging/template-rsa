{
  "config_version": "1.0",
  "created_by": "AKH",
  "notes": "Bretton, Kim, Banich & Lewis-Peacock (2024) J Cogn Neurosci 36:2117 -- CORE settings of the feature-weighted exemplar- and category-level fidelity (the paper's item- and category-level); the study-specific statistics (memory flag from the post-test responses, operation joined from the WM phase, remembered vs forgotten per operation, mixed models, bootstrap CIs, ROI specificity) are in _interactive_notebooks/bretton2024_ltm_fidelity.ipynb. Method: docs/lab_methods.md (section B). ASSUMED events.tsv schema (rename to match yours): every row has stimulus (exemplar id) and category (scene/face) -- events.hierarchy category > stimulus; task-prememory trial_type names each exemplar's status, 'old_<exemplar>' (seen in the initial exposure) or 'new_<exemplar>'; the template exemplars are the new scenes (category 'scene' and trial_type matching 'new_.*'), i.e. the 90 scenes that will be manipulated -- the old scenes and all faces are modeled, but get no template; task-study / task-postmemory rows trial_type='stimulus'; task-study rows also carry operation (maintain/replace/suppress); task-postmemory rows carry the raw response (old/new) and confidence (sure/unsure). TR = 1 s, fMRIPrep MNI152NLin2009cAsym, 5 s hemodynamic lag. ROIs from fMRIPrep aparcaseg (Desikan-Killiany; confirm the VVS label set with the lab).",
  "event_extraction": {
    "bids_root": "/path/to/bids",
    "derivatives_root": "/path/to/bids/derivatives/fmriprep",
    "bold_glob": "sub-{subject}/func/sub-{subject}_task-{task}_run-{run}_space-MNI152NLin2009cAsym_desc-preproc_bold.nii.gz",
    "events_glob": "sub-*/func/*_events.tsv",
    "output_file": "out/bretton2024/master_spreadsheet.csv"
  },
  "events": {
    "hierarchy": [
      "category",
      "stimulus"
    ]
  },
  "pattern_estimation": {
    "confounds": {
      "source": "fmriprep",
      "strategy": [
        "motion",
        "wm_csf",
        "high_pass",
        "non_steady_state"
      ],
      "motion": "full",
      "wm_csf": "basic"
    },
    "censoring": {
      "mode": "censor"
    },
    "glm": {
      "hrf_model": "glover",
      "drift_model": null,
      "high_pass": null,
      "noise_model": "ar1",
      "smoothing_fwhm": null,
      "signal_scaling": 0
    }
  },
  "rois": {
    "vvs": {
      "atlas_pattern": "/path/to/bids/derivatives/fmriprep/sub-{subject}/anat/sub-{subject}_space-MNI152NLin2009cAsym_desc-aparcaseg_dseg.nii.gz",
      "labels": [
        1007,
        1009,
        1011,
        1013,
        1015,
        1016,
        1021,
        1030,
        1033,
        2007,
        2009,
        2011,
        2013,
        2015,
        2016,
        2021,
        2030,
        2033
      ]
    },
    "pfc": {
      "atlas_pattern": "/path/to/bids/derivatives/fmriprep/sub-{subject}/anat/sub-{subject}_space-MNI152NLin2009cAsym_desc-aparcaseg_dseg.nii.gz",
      "labels": [
        1003,
        1012,
        1014,
        1027,
        1028,
        1032,
        2003,
        2012,
        2014,
        2027,
        2028,
        2032
      ]
    },
    "parietal": {
      "atlas_pattern": "/path/to/bids/derivatives/fmriprep/sub-{subject}/anat/sub-{subject}_space-MNI152NLin2009cAsym_desc-aparcaseg_dseg.nii.gz",
      "labels": [
        1008,
        1025,
        1029,
        2008,
        2025,
        2029
      ]
    },
    "hippocampus": {
      "atlas_pattern": "/path/to/bids/derivatives/fmriprep/sub-{subject}/anat/sub-{subject}_space-MNI152NLin2009cAsym_desc-aparcaseg_dseg.nii.gz",
      "labels": [
        17,
        53
      ]
    }
  },
  "template_rsa": {
    "rois": [
      "vvs",
      "pfc",
      "parietal",
      "hippocampus"
    ],
    "category_level": "category",
    "subcategory_level": null,
    "timeseries": {
      "detrend": true,
      "standardize": "zscore_sample",
      "high_pass": null,
      "regress_confounds": true
    },
    "templates": {
      "events": {
        "and": [
          {
            "column": "task",
            "match": "exact",
            "value": "prememory"
          },
          {
            "column": "category",
            "match": "exact",
            "value": "scene"
          },
          {
            "column": "trial_type",
            "match": "regex",
            "value": "new_.*"
          }
        ]
      },
      "window": {
        "start": {
          "reference": "onset",
          "offset_seconds": 5.0
        },
        "end": {
          "reference": "offset_end",
          "offset_seconds": 5.0
        }
      }
    },
    "feature_weighting": {
      "levels": [
        "exemplar",
        "category"
      ],
      "category_mask": {
        "enabled": true,
        "events": {
          "column": "task",
          "match": "exact",
          "value": "prememory"
        },
        "p_threshold": 0.05,
        "cluster_extent": 10,
        "min_voxels": 10
      },
      "exemplar_contrast": "all_others",
      "weight_target_patterns": true
    },
    "validation": {
      "enabled": false
    },
    "targets": {
      "manipulation": {
        "events": {
          "and": [
            {
              "column": "task",
              "match": "exact",
              "value": "study"
            },
            {
              "column": "trial_type",
              "match": "exact",
              "value": "stimulus"
            },
            {
              "column": "category",
              "match": "exact",
              "value": "scene"
            }
          ]
        },
        "mode": "window_mean",
        "window": {
          "start": {
            "reference": "onset",
            "offset_seconds": 5.0
          },
          "end": {
            "reference": "offset_end",
            "offset_seconds": 5.0
          }
        },
        "group": {
          "group_by": [
            "operation"
          ],
          "comparisons": [
            "target",
            "related"
          ]
        }
      },
      "post_test": {
        "events": {
          "and": [
            {
              "column": "task",
              "match": "exact",
              "value": "postmemory"
            },
            {
              "column": "trial_type",
              "match": "exact",
              "value": "stimulus"
            },
            {
              "column": "category",
              "match": "exact",
              "value": "scene"
            }
          ]
        },
        "mode": "window_mean",
        "window": {
          "start": {
            "reference": "onset",
            "offset_seconds": 5.0
          },
          "end": {
            "reference": "offset_end",
            "offset_seconds": 5.0
          }
        },
        "group": {
          "group_by": [],
          "comparisons": [
            "target",
            "related"
          ]
        }
      }
    }
  },
  "pipeline": {
    "output_dir": "out/bretton2024",
    "subjects": null,
    "analyses": [
      "template"
    ]
  }
}
