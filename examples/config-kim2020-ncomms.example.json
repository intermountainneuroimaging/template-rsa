{
  "config_version": "1.0",
  "created_by": "AKH",
  "notes": "Kim, Smolker, Smith, Banich & Lewis-Peacock (2020) Nat Commun 11:6239 -- CORE settings of the exemplar-level ('weighted') RSA (the paper's 'item-level'); the study-specific statistics (baseline / minus-maintain timecourses, 3-TR window tests, removal onsets, replacement-category tracking, encoding fidelity and the trial N+1 analysis) are in _interactive_notebooks/kim2020_removal_operations.ipynb. Method: docs/lab_methods.md (section K). ASSUMED events.tsv schema (rename to match yours): task-localizer rows trial_type='stimulus' with stimulus (54 exemplar ids), category (face/fruit/scene), subcategory (9) -- events.hierarchy category > subcategory > stimulus; task-study rows trial_type='stimulus' at trial onset with the same hierarchy columns plus operation (maintain/replace_category/replace_subcategory/suppress/clear) and replace_category (category switched to on replace trials, empty otherwise). fMRIPrep space-T1w inputs.",
  "event_extraction": {
    "bids_root": "/path/to/bids",
    "derivatives_root": "/path/to/bids/derivatives/fmriprep",
    "bold_glob": "sub-{subject}/func/sub-{subject}_task-{task}_run-{run}_space-T1w_desc-preproc_bold.nii.gz",
    "events_glob": "sub-*/func/*_events.tsv",
    "output_file": "out/kim2020/master_spreadsheet.csv"
  },
  "events": {
    "hierarchy": [
      "category",
      "subcategory",
      "stimulus"
    ]
  },
  "pattern_estimation": {
    "confounds": {
      "source": "fmriprep",
      "strategy": [
        "motion",
        "scrub"
      ],
      "motion": "basic",
      "min_segment_volumes": 0,
      "fd_threshold": 0.9,
      "std_dvars_threshold": 1000
    },
    "censoring": {
      "drop_initial_volumes": 10,
      "mode": "censor"
    },
    "glm": {
      "hrf_model": "spm",
      "drift_model": "cosine",
      "high_pass": 0.0078,
      "noise_model": "ar1",
      "smoothing_fwhm": null,
      "signal_scaling": 0
    }
  },
  "rois": {
    "vvs": {
      "mask_pattern": "/path/to/rois/sub-{subject}_space-T1w_label-VVS_mask.nii.gz"
    }
  },
  "template_rsa": {
    "rois": [
      "vvs"
    ],
    "category_level": "category",
    "subcategory_level": "subcategory",
    "timeseries": {
      "detrend": true,
      "standardize": "zscore_sample",
      "high_pass": 0.0078,
      "regress_confounds": false
    },
    "templates": {
      "events": {
        "and": [
          {
            "column": "task",
            "match": "exact",
            "value": "localizer"
          },
          {
            "column": "trial_type",
            "match": "exact",
            "value": "stimulus"
          }
        ]
      },
      "window": {
        "start": {
          "reference": "onset",
          "offset_seconds": 4.6
        },
        "end": {
          "reference": "offset_end",
          "offset_seconds": 4.6
        }
      }
    },
    "feature_weighting": {
      "levels": [
        "exemplar"
      ],
      "category_mask": {
        "enabled": true,
        "p_threshold": 0.05,
        "cluster_extent": 10,
        "min_voxels": 10,
        "block_merge_gap_seconds": 5.0
      },
      "exemplar_contrast": "all_others",
      "weight_target_patterns": true
    },
    "validation": {
      "enabled": true,
      "methods": [
        "kim2020"
      ]
    },
    "targets": {
      "study_timecourse": {
        "events": {
          "and": [
            {
              "column": "task",
              "match": "exact",
              "value": "study"
            },
            {
              "column": "trial_type",
              "match": "exact",
              "value": "stimulus"
            }
          ]
        },
        "mode": "timecourse",
        "window": {
          "start": {
            "reference": "onset",
            "offset_seconds": 0
          },
          "end": {
            "reference": "onset",
            "offset_seconds": 13.8
          }
        },
        "related_level": "category",
        "extra_sets": {
          "replacement": {
            "column": "replace_category",
            "level": "category"
          }
        },
        "group": {
          "group_by": [
            "operation"
          ],
          "comparisons": [
            "target",
            "related",
            "others",
            "replacement"
          ]
        }
      },
      "encoding_fidelity": {
        "events": {
          "and": [
            {
              "column": "task",
              "match": "exact",
              "value": "study"
            },
            {
              "column": "trial_type",
              "match": "exact",
              "value": "stimulus"
            }
          ]
        },
        "mode": "window_mean",
        "window": {
          "start": {
            "reference": "onset",
            "offset_seconds": 4.6
          },
          "end": {
            "reference": "offset_end",
            "offset_seconds": 4.6
          }
        },
        "related_level": "category",
        "group": {
          "group_by": [
            "operation"
          ],
          "comparisons": [
            "target",
            "related",
            "others"
          ]
        }
      }
    }
  },
  "pipeline": {
    "output_dir": "out/kim2020",
    "subjects": null,
    "analyses": [
      "template",
      "decoding"
    ]
  }
}
