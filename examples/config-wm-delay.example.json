{
  "config_version": "1.0",
  "created_by": "AKH",
  "notes": "SKELETON for a delayed-recall working-memory task (see docs/working_memory_rsa.md): events.tsv has one row per trial phase (trial_type = encoding | delay | probe), a 'stimulus' column (here 4 orientations) and a 'phase_stimulus' column naming the phase x stimulus exemplar (encoding_0 ... delay_135), so the hierarchy trial_type > phase_stimulus nests. One crossnobis RDM then contains the within-encoding, within-delay and encoding-vs-delay blocks. Incorrect trials fail item_filter and, like the probes, are modeled as nuisance regressors. Stimulus identity crosses the phases, so its model lists explicit groups. Paths and stimulus values are placeholders.",
  "event_extraction": {
    "bids_root": "/path/to/bids",
    "derivatives_root": "/path/to/bids/derivatives/fmriprep",
    "bold_glob": "sub-{subject}/func/sub-{subject}_task-{task}_run-{run}_space-T1w_desc-preproc_bold.nii.gz",
    "events_glob": "sub-*/func/*_task-wm_*_events.tsv",
    "output_file": "out/wm/master_spreadsheet.csv"
  },
  "events": {
    "hierarchy": [
      "trial_type",
      "phase_stimulus"
    ],
    "item_types": [
      "encoding",
      "delay"
    ],
    "item_filter": {
      "column": "correct",
      "match": "exact",
      "value": "1"
    }
  },
  "pattern_estimation": {
    "method": "glm",
    "mask_pattern": "/path/to/bids/derivatives/fmriprep/sub-{subject}/func/sub-{subject}_task-wm_*_space-T1w_desc-brain_mask.nii.gz",
    "model_unlabeled_events": true,
    "confounds": {
      "source": "fmriprep",
      "strategy": [
        "motion",
        "high_pass",
        "wm_csf",
        "scrub",
        "non_steady_state"
      ],
      "motion": "full",
      "min_segment_volumes": 0,
      "fd_threshold": 0.5,
      "std_dvars_threshold": 1.5
    },
    "censoring": {
      "mode": "censor"
    },
    "glm": {
      "output_type": "beta",
      "hrf_model": "glover",
      "drift_model": null,
      "high_pass": null,
      "noise_model": "ar1",
      "smoothing_fwhm": null
    }
  },
  "rois": {
    "V1": {
      "mask_pattern": "/path/to/rois/sub-{subject}_space-T1w_label-V1_mask.nii.gz"
    },
    "IPS": {
      "mask_pattern": "/path/to/rois/sub-{subject}_space-T1w_label-IPS_mask.nii.gz"
    },
    "dlPFC": {
      "mask_pattern": "/path/to/rois/sub-{subject}_space-T1w_label-dlPFC_mask.nii.gz"
    }
  },
  "rdm": {
    "method": "crossnobis",
    "cv_descriptor": "run",
    "noise": {
      "method": "shrinkage_diag"
    }
  },
  "model_rdms": {
    "orientation": {
      "type": "feature",
      "metric": "euclidean",
      "features": {
        "encoding_0": [
          1.0,
          0.0
        ],
        "encoding_45": [
          0.0,
          1.0
        ],
        "encoding_90": [
          -1.0,
          0.0
        ],
        "encoding_135": [
          -0.0,
          -1.0
        ],
        "delay_0": [
          1.0,
          0.0
        ],
        "delay_45": [
          0.0,
          1.0
        ],
        "delay_90": [
          -1.0,
          0.0
        ],
        "delay_135": [
          -0.0,
          -1.0
        ]
      }
    },
    "stimulus_identity": {
      "type": "categorical",
      "groups": {
        "encoding_0": "0",
        "encoding_45": "45",
        "encoding_90": "90",
        "encoding_135": "135",
        "delay_0": "0",
        "delay_45": "45",
        "delay_90": "90",
        "delay_135": "135"
      }
    },
    "phase": {
      "type": "categorical",
      "level": "trial_type"
    }
  },
  "weighted_models": {
    "orientation+phase": {
      "components": [
        "orientation",
        "phase"
      ],
      "fitter": "optimize_positive"
    }
  },
  "comparison": {
    "method": "cosine"
  },
  "group": {
    "test": "ttest",
    "alternative": "greater",
    "noise_ceiling": true,
    "multiple_comparisons": "fdr_bh",
    "crossval": {
      "scheme": "leave_one_subject_out",
      "include_fixed": true
    }
  },
  "pipeline": {
    "output_dir": "out/wm",
    "subjects": [
      "01",
      "02",
      "03"
    ]
  }
}
