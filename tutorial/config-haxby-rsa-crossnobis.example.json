{
  "config_version": "1.0",
  "created_by": "AKH",
  "notes": "Same as config-haxby-rsa.example.json but with cross-validated Mahalanobis (crossnobis) distances, cross-validated over runs, with a shrinkage-diagonal noise precision estimated from the run-wise beta patterns. Unbiased (expected 0 for identical patterns), so the noise ceiling and model fits are on a ratio scale.",
  "event_extraction": {
    "bids_root": "data/haxby-bids",
    "derivatives_root": "data/haxby-bids/derivatives/preproc",
    "bold_glob": "sub-{subject}/func/sub-{subject}_task-{task}_run-{run}_desc-preproc_bold.nii.gz",
    "events_glob": "sub-*/func/*_events.tsv",
    "output_file": "out/haxby/master_spreadsheet_haxby.csv"
  },
  "events": {
    "hierarchy": [
      "animacy",
      "superordinate",
      "category"
    ]
  },
  "pattern_estimation": {
    "method": "glm",
    "mask_pattern": "data/haxby-bids/derivatives/preproc/sub-{subject}/masks/brain_mask.nii.gz",
    "glm": {
      "output_type": "beta",
      "hrf_model": "glover",
      "drift_model": "cosine",
      "high_pass": 0.008,
      "noise_model": "ar1",
      "smoothing_fwhm": null
    }
  },
  "rois": {
    "vt": {
      "mask_pattern": "data/haxby-bids/derivatives/preproc/sub-{subject}/masks/vt_mask.nii.gz"
    },
    "face": {
      "mask_pattern": "data/haxby-bids/derivatives/preproc/sub-{subject}/masks/face_mask.nii.gz"
    },
    "house": {
      "mask_pattern": "data/haxby-bids/derivatives/preproc/sub-{subject}/masks/house_mask.nii.gz"
    }
  },
  "searchlight": {
    "enabled": false,
    "mask_pattern": "data/haxby-bids/derivatives/preproc/sub-{subject}/masks/brain_mask.nii.gz",
    "radius_voxels": 3,
    "threshold": 0.7,
    "n_jobs": 4
  },
  "rdm": {
    "method": "crossnobis",
    "cv_descriptor": "run",
    "noise": {
      "method": "shrinkage_diag"
    },
    "remove_voxel_mean": false
  },
  "model_rdms": {
    "animacy": {
      "type": "categorical",
      "level": "animacy"
    },
    "superordinate": {
      "type": "categorical",
      "level": "superordinate"
    },
    "face_vs_other": {
      "type": "categorical",
      "groups": {
        "face": "face",
        "cat": "other",
        "house": "other",
        "chair": "other",
        "shoe": "other",
        "bottle": "other",
        "scissors": "other",
        "scrambledpix": "other"
      }
    },
    "intact_vs_scrambled": {
      "type": "categorical",
      "groups": {
        "face": "intact",
        "cat": "intact",
        "house": "intact",
        "chair": "intact",
        "shoe": "intact",
        "bottle": "intact",
        "scissors": "intact",
        "scrambledpix": "scrambled"
      }
    }
  },
  "weighted_models": {
    "animacy+intact": {
      "components": [
        "animacy",
        "intact_vs_scrambled"
      ],
      "fitter": "optimize_positive"
    },
    "all_categorical": {
      "components": [
        "animacy",
        "superordinate",
        "face_vs_other",
        "intact_vs_scrambled"
      ],
      "fitter": "optimize_positive"
    }
  },
  "comparison": {
    "method": "cosine"
  },
  "group": {
    "test": "ttest",
    "alternative": "greater",
    "noise_ceiling": true,
    "multiple_comparisons": "fdr_bh",
    "alpha": 0.05,
    "crossval": {
      "scheme": "leave_one_subject_out",
      "include_fixed": true
    }
  },
  "pipeline": {
    "output_dir": "out/haxby-crossnobis",
    "subjects": [
      "1",
      "2",
      "3",
      "4",
      "5",
      "6"
    ]
  }
}
