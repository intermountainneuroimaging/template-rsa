{
  "config_version": "1.0",
  "created_by": "AKH",
  "notes": "Validation config: Haxby et al. 2001 (Science 293:2425; OpenNeuro ds000105, nilearn/PyMVPA motion-corrected release, re-laid out by tutorial/fetch_haxby.py). 8 object categories x 12 runs, 24 s blocks. One GLM t-map per category per run (nilearn FirstLevelModel), correlation-distance RDMs in the VT / face / house masks shipped with the data, Kendall tau-a against categorical model RDMs, subject-level random-effects t-tests across 6 subjects. See tutorial/README.md for the published results this is checked against.",
  "event_extraction": {
    "bids_root": "data/haxby-bids",
    "derivatives_root": "data/haxby-bids/derivatives/preproc",
    "bold_glob": "sub-{subject}/func/sub-{subject}_task-{task}_run-{run}_desc-preproc_bold.nii.gz",
    "events_glob": "sub-*/func/*_events.tsv",
    "output_file": "out/haxby/master_spreadsheet_haxby.csv"
  },
  "events": {
    "hierarchy": [
      "animacy",
      "superordinate",
      "category"
    ]
  },
  "pattern_estimation": {
    "method": "glm",
    "mask_pattern": "data/haxby-bids/derivatives/preproc/sub-{subject}/masks/brain_mask.nii.gz",
    "glm": {
      "output_type": "t",
      "hrf_model": "glover",
      "drift_model": "cosine",
      "high_pass": 0.008,
      "noise_model": "ar1",
      "smoothing_fwhm": null
    }
  },
  "rois": {
    "vt": {
      "mask_pattern": "data/haxby-bids/derivatives/preproc/sub-{subject}/masks/vt_mask.nii.gz"
    },
    "face": {
      "mask_pattern": "data/haxby-bids/derivatives/preproc/sub-{subject}/masks/face_mask.nii.gz"
    },
    "house": {
      "mask_pattern": "data/haxby-bids/derivatives/preproc/sub-{subject}/masks/house_mask.nii.gz"
    }
  },
  "searchlight": {
    "enabled": false,
    "mask_pattern": "data/haxby-bids/derivatives/preproc/sub-{subject}/masks/brain_mask.nii.gz",
    "radius_voxels": 3,
    "threshold": 0.7,
    "n_jobs": 4
  },
  "rdm": {
    "method": "correlation",
    "cv_descriptor": "run",
    "noise": {
      "method": "shrinkage_diag"
    },
    "remove_voxel_mean": false
  },
  "model_rdms": {
    "animacy": {
      "type": "categorical",
      "level": "animacy"
    },
    "superordinate": {
      "type": "categorical",
      "level": "superordinate"
    },
    "face_vs_other": {
      "type": "categorical",
      "groups": {
        "face": "face",
        "cat": "other",
        "house": "other",
        "chair": "other",
        "shoe": "other",
        "bottle": "other",
        "scissors": "other",
        "scrambledpix": "other"
      }
    },
    "intact_vs_scrambled": {
      "type": "categorical",
      "groups": {
        "face": "intact",
        "cat": "intact",
        "house": "intact",
        "chair": "intact",
        "shoe": "intact",
        "bottle": "intact",
        "scissors": "intact",
        "scrambledpix": "scrambled"
      }
    }
  },
  "weighted_models": {
    "animacy+intact": {
      "components": [
        "animacy",
        "intact_vs_scrambled"
      ],
      "fitter": "optimize_positive"
    },
    "all_categorical": {
      "components": [
        "animacy",
        "superordinate",
        "face_vs_other",
        "intact_vs_scrambled"
      ],
      "fitter": "optimize_positive"
    }
  },
  "comparison": {
    "method": "tau-a"
  },
  "group": {
    "test": "ttest",
    "alternative": "greater",
    "noise_ceiling": true,
    "multiple_comparisons": "fdr_bh",
    "alpha": 0.05,
    "crossval": {
      "scheme": "leave_one_subject_out",
      "include_fixed": true
    }
  },
  "pipeline": {
    "output_dir": "out/haxby",
    "subjects": [
      "1",
      "2",
      "3",
      "4",
      "5",
      "6"
    ]
  }
}
